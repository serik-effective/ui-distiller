# Captured third-party material: other people's HTML/CSS/JS, pulled for analysis.
# Never committed — it is not ours, it is bulky, and the analysis that matters
# already lives in the reports and candidate logs.
ui-distilled/*/.work/raw/
ui-distilled/*/.work/**/raw/
ui-distilled/*/.work/shots/
ui-distilled/*/.work/**/shots/

# Reference frames ARE kept: they are the evidence behind every fidelity claim.
# Scratch comparison output is not.
ui-distilled/*/.work/refs/tmp*.png
ui-distilled/*/.work/refs/*.diff.png
ui-distilled/*/.work/refs/cand-*.png
ui-distilled/*/.work/*.json
ui-distilled/*/.work/*/*.json

# Build output
dist/

# Local tooling
node_modules/
.DS_Store
.playwright-mcp/
